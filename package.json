    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.0",
    "vosk-browser": "^0.0.8"
  }
